# Sign-in: "clerk" (deployed, default) or "local" (no outside account; needs LOCAL_AUTH_SECRET = the API's)
NEXT_PUBLIC_AUTH_MODE=clerk
#LOCAL_AUTH_SECRET=any-string-of-at-least-32-characters-shared-with-the-api
# Server-side calls (sign-in page, local login); defaults to NEXT_PUBLIC_API_URL
#API_INTERNAL_URL=http://localhost:8000

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

NEXT_PUBLIC_API_URL=http://localhost:8000
