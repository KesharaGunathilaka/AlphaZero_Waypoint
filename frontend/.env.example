# Waypoint web app settings.
#
#   Local     copy this file to frontend/.env.local to run the web app on your PC without Docker:
#             pnpm install && pnpm dev   (the API on :8000: Docker or backend/.env.example)
#   Deployed  the Vercel web project (Root Directory = frontend): set the "Deployed" variables below
#             in Vercel -> Settings -> Environment Variables. NEXT_PUBLIC_* are built into the pages:
#             redeploy after changing one.
#   Docker    docker compose sets the web app's variables itself; this file is not used.

# ======================= Local =======================
NEXT_PUBLIC_API_URL=http://localhost:8000
# Sign-in with the demo accounts. The same secret goes in backend/.env.
NEXT_PUBLIC_AUTH_MODE=local
LOCAL_AUTH_SECRET=local-dev-secret-shared-by-api-and-web-0123456789

# ======================= Deployed (Vercel web project) =======================
# NEXT_PUBLIC_API_URL=https://waypoint-api.vercel.app
# NEXT_PUBLIC_AUTH_MODE=clerk
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_...
# CLERK_SECRET_KEY=sk_...
# NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
# NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/
