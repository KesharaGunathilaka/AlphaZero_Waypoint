# The deployed web app: Vercel project with Root Directory = frontend (framework: Next.js).
# Vercel -> Project -> Settings -> Environment Variables -> paste this file (with real values) into
# the key/value form. NEXT_PUBLIC_* values are built into the pages, so redeploy after changing them.
# Never commit the filled-in copy.

# The deployed API (no trailing slash)
NEXT_PUBLIC_API_URL=https://waypoint-api.vercel.app

# --- Sign-in: Clerk (Clerk Dashboard -> Configure -> API keys) ---
NEXT_PUBLIC_AUTH_MODE=clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_or_test_...
CLERK_SECRET_KEY=sk_live_or_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/
