# Waypoint API settings.
#
#   Local     copy this file to backend/.env to run the API on your PC without Docker:
#             docker compose up db  (from the repo root), then  uv sync && uv run fastapi dev app/main.py
#   Deployed  the Vercel API project (Root Directory = backend): set the "Deployed" variables below
#             in Vercel -> Settings -> Environment Variables, with the real values.
#   Docker    docker compose sets the API's variables itself; this file is not used.

# ======================= Local =======================
ENVIRONMENT=development
# Database: the Docker database on localhost:5433 is the default (nothing to set).
# Sign-in with the demo accounts (password waypoint-demo). The same secret goes in frontend/.env.local.
AUTH_MODE=local
LOCAL_AUTH_SECRET=local-dev-secret-shared-by-api-and-web-0123456789
CORS_ORIGINS=["http://localhost:3000"]
ALLOWED_HOSTS=["localhost","127.0.0.1"]
PUBLIC_API_URL=http://localhost:8000

# ======================= Deployed (Vercel API project) =======================
# Replace waypoint-api.vercel.app / waypoint-web.vercel.app with your two Vercel domains.
#
# ENVIRONMENT=production
#
# Neon: the POOLED connection string (host contains -pooler)
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require
#
# Clerk (Dashboard -> Configure -> API keys; issuer = the Frontend API URL)
# AUTH_MODE=clerk
# CLERK_JWKS_URL=https://<your-instance>.clerk.accounts.dev/.well-known/jwks.json
# CLERK_ISSUER=https://<your-instance>.clerk.accounts.dev
# CLERK_SECRET_KEY=sk_...
# CLERK_AUTHORIZED_PARTIES=["https://waypoint-web.vercel.app"]
#
# Who may call the API
# CORS_ORIGINS=["https://waypoint-web.vercel.app"]
# ALLOWED_HOSTS=["waypoint-api.vercel.app"]
# PUBLIC_API_URL=https://waypoint-api.vercel.app
#
# Photos and signatures: Neon object storage (S3 API)
# STORAGE_BACKEND=s3
# S3_BUCKET=images
# AWS_ENDPOINT_URL_S3=https://<your-bucket-endpoint>.neon.tech
# AWS_REGION=ap-southeast-1
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
