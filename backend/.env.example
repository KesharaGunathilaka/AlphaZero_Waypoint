# Running the API on your PC (not Docker): copy to backend/.env, then
#   uv sync && uv run fastapi dev app/main.py
# For the deployed API (Vercel) use backend/.env.production.example instead.
ENVIRONMENT=development

# --- Database: pick ONE ---
# a) The Docker database (`docker compose up db`): nothing to set, these are the defaults:
#    POSTGRES_HOST=localhost  POSTGRES_PORT=5433  POSTGRES_USER=waypoint  POSTGRES_PASSWORD=waypoint  POSTGRES_DB=waypoint
# b) Neon: its connection string. Use the POOLED one (host contains -pooler) for the API.
#DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# --- Sign-in: "local" (demo accounts, password waypoint-demo) or "clerk" (as deployed) ---
AUTH_MODE=local
# The same value goes in frontend/.env.local (32+ characters)
LOCAL_AUTH_SECRET=local-dev-secret-shared-by-api-and-web-0123456789
#CLERK_JWKS_URL=https://<your-instance>.clerk.accounts.dev/.well-known/jwks.json
#CLERK_ISSUER=https://<your-instance>.clerk.accounts.dev
#CLERK_SECRET_KEY=sk_test_...

# Tests and curl only: accept "X-Dev-User: <email>" instead of a token (never in production).
#AUTH_DEV_BYPASS=true

CORS_ORIGINS=["http://localhost:3000"]
ALLOWED_HOSTS=["localhost","127.0.0.1"]
PUBLIC_API_URL=http://localhost:8000
