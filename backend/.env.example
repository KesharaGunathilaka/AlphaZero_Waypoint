# Copy to backend/.env for running the API on your PC (uv run fastapi dev app/main.py).
ENVIRONMENT=development

# --- Database: pick ONE ---
# a) Docker database from `docker compose up db` (default; no line needed):
#    POSTGRES_HOST=localhost  POSTGRES_PORT=5433  POSTGRES_USER=waypoint  POSTGRES_PASSWORD=waypoint  POSTGRES_DB=waypoint
# b) Neon: paste the connection string. Use the POOLED one (host contains -pooler) for the API.
#DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# --- Sign-in: "local" (the API checks the demo accounts' passwords) or "clerk" (deployed) ---
#AUTH_MODE=local
#LOCAL_AUTH_SECRET=any-string-of-at-least-32-characters-shared-with-the-web-app

# --- Clerk (AUTH_MODE=clerk, the default) ---
#CLERK_JWKS_URL=https://<your-instance>.clerk.accounts.dev/.well-known/jwks.json
#CLERK_ISSUER=https://<your-instance>.clerk.accounts.dev
#CLERK_AUTHORIZED_PARTIES=["http://localhost:3000"]
CORS_ORIGINS=["http://localhost:3000"]
ALLOWED_HOSTS=["localhost","127.0.0.1"]
