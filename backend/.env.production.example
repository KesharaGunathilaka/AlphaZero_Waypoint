# The deployed API: Vercel project with Root Directory = backend.
# Vercel -> Project -> Settings -> Environment Variables -> paste this file (with real values) into
# the key/value form; it splits the lines into variables. Never commit the filled-in copy.
# Replace waypoint-api.vercel.app / waypoint-web.vercel.app with your two Vercel domains.

ENVIRONMENT=production

# --- Database: Neon, the POOLED connection string (host contains -pooler) ---
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# --- Sign-in: Clerk (Clerk Dashboard -> Configure -> API keys) ---
AUTH_MODE=clerk
CLERK_JWKS_URL=https://<your-instance>.clerk.accounts.dev/.well-known/jwks.json
CLERK_ISSUER=https://<your-instance>.clerk.accounts.dev
# Used once per new sign-in to read the user's e-mail and link it to the Waypoint account.
CLERK_SECRET_KEY=sk_live_or_test_...
# The web app's address (required in production)
CLERK_AUTHORIZED_PARTIES=["https://waypoint-web.vercel.app"]

# --- Who may call the API ---
CORS_ORIGINS=["https://waypoint-web.vercel.app"]
ALLOWED_HOSTS=["waypoint-api.vercel.app"]
PUBLIC_API_URL=https://waypoint-api.vercel.app

# --- Photos and signatures: Neon object storage (S3 API), values from .env.aws ---
STORAGE_BACKEND=s3
S3_BUCKET=images
AWS_ENDPOINT_URL_S3=https://<your-bucket-endpoint>.neon.tech
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=...
AWS_SECRET_ACCESS_KEY=...
