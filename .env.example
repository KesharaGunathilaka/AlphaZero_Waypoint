# Copy to .env for local overrides. `docker compose up` also works with no .env (defaults below).

# --- Local Postgres (docker compose "db" service) ---
POSTGRES_USER=waypoint
POSTGRES_PASSWORD=waypoint
POSTGRES_DB=waypoint
# 5433 so the Docker database does not clash with a Postgres installed on your PC (5432)
DB_PORT=5433
API_PORT=8000

# --- Neon (deployed database) ---
# Put the real connection string in .env.neon (git-ignored), never here:
#   NEON_DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require
