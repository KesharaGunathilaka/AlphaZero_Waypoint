# Docker Compose settings. Optional: `docker compose up` works without a .env file (these are the
# defaults). To change something, copy this file to .env at the repository root and edit it.
#
# The deployed app (Vercel + Neon + Clerk) does not use this file: its variables are listed in
# backend/.env.example and frontend/.env.example ("Deployed" sections).

# --- Database (the "db" service: PostgreSQL 18, loaded with schema, CSVs and a demo day on first start) ---
POSTGRES_USER=waypoint
POSTGRES_PASSWORD=waypoint
POSTGRES_DB=waypoint

# --- Ports on your machine ---
# 5433 so the Docker database does not clash with a Postgres installed on your PC (5432)
DB_PORT=5433
API_PORT=8000
WEB_PORT=3000

# --- Sign-in ---
# local: no outside account needed. The sign-in page lists the demo accounts; all use the password
# "waypoint-demo". The secret signs the session tokens (32+ characters, shared by api and web).
AUTH_MODE=local
LOCAL_AUTH_SECRET=docker-local-only-secret-change-me-0123456789

# Only to try Clerk sign-in inside Docker (AUTH_MODE=clerk). Clerk Dashboard -> API keys; the JWKS
# URL and issuer are your instance's Frontend API URL.
#NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
#CLERK_SECRET_KEY=sk_test_...
#CLERK_JWKS_URL=https://<your-instance>.clerk.accounts.dev/.well-known/jwks.json
#CLERK_ISSUER=https://<your-instance>.clerk.accounts.dev
